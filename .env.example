# Copy to .env for local development.

# Bind address: empty = all interfaces; 127.0.0.1 = this machine only.
HOST=
PORT=8080
DATABASE_URL=postgres://capital:capital@localhost:5432/capital?sslmode=disable

# From @BotFather. Leave empty in local dev and set ALLOW_DEV_LOGIN=true instead.
TELEGRAM_BOT_TOKEN=

JWT_SECRET=change-me-in-prod

# When true, /auth/telegram accepts requests without initData and returns a
# fixed dev user. NEVER enable in production.
ALLOW_DEV_LOGIN=true

# Comma-separated list, or * for any origin. Not needed when the frontend is
# served from the same origin via WEB_DIR.
CORS_ORIGINS=*

# Serve the built frontend from this directory (single origin, one tunnel).
# Build the frontend first: (cd ../web && npm run build) → ../web/dist
# Leave empty in dev (the Vite dev server serves the frontend on :5173).
WEB_DIR=

# Local HTTPS. Generate a trusted cert with mkcert, then point these at it:
#   brew install mkcert nss && mkcert -install
#   mkcert -cert-file certs/capital.test.pem -key-file certs/capital.test-key.pem capital.test localhost 127.0.0.1
# Leave empty to serve plain HTTP.
TLS_CERT=
TLS_KEY=

# --- Production (public via bot) checklist ---
# ALLOW_DEV_LOGIN=false   (REQUIRED — otherwise all users share one account)
# TELEGRAM_BOT_TOKEN=...   (from @BotFather)
# JWT_SECRET=<long random>
# WEB_DIR=../web/dist
